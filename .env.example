# انسخ هذا الملف إلى .env محلياً (لا يُرفع أبداً) — وفي Vercel أضفها كمتغيرات بيئة:
# vercel env add RESEND_API_KEY production
RESEND_API_KEY=re_ضع_المفتاح_الجديد_هنا
# بريد المالك الذي يستلم الإشعارات:
OWNER_EMAIL=info@alazsoftware.com
# عنوان المرسل: يجب أن يكون دوميناً موثقاً في Resend، وإلا استخدم onboarding@resend.dev للتجربة:
FROM_EMAIL=onboarding@resend.dev
